import json
import os
import subprocess
import sys

from fractions import Fraction

def calculate_display_size(width, height, ratio):
    if ratio == 0:
        return width, height
    dw = int(2 * round(max(width, ratio * height) / 2))
    dh = int(2 * round(max(height, width / ratio) / 2))
    return dw, dh

def estimate_missing_bitrate(container, streams):
    # If ffprobe fails to detect the bitrate of just one track, we can
    # calculate that by subtracting bitrates of known tracks from the total
    # bitrate of the whole file. Considering only audio and video tracks, there
    # will be a small error since the space used by subtitles and the container
    # metadata are not accounted for.
    for stream in streams:
        stream["bit_rate_fuzzy"] = "bit_rate" not in stream
    missing = [x for x in streams if x["bit_rate_fuzzy"]]
    if len(missing) != 1: return
    known = sum(float(x["bit_rate"]) for x in streams if "bit_rate" in x)
    missing[0]["bit_rate"] = str(int(float(container["bit_rate"]) - known))

def format_codec(stream):
    tag = stream["codec_tag_string"].lower()
    return stream["codec_name"] if "[0]" in tag else tag

def format_language(stream):
    language = stream.get("tags", {}).get("language", "und")
    return [] if language == "und" else [language]

def main(path):
    command = ("ffprobe", "-v", "error", "-of", "json",
               "-show_format", "-show_streams", path)
    result = subprocess.run(command, stdout=subprocess.PIPE)
    if result.returncode != 0:
        raise SystemExit(result.returncode)
    probe = json.loads(result.stdout)
    container = probe["format"]
    streams = probe["streams"]
    video = [x for x in streams if x.get("codec_type") == "video"]
    audio = [x for x in streams if x.get("codec_type") == "audio"]
    subtitles = [x for x in streams if x.get("codec_type") == "subtitle"]
    estimate_missing_bitrate(container, audio + video)
    print_general(path, container)
    for stream in video:
        print_video(stream)
    for stream in audio:
        print_audio(stream)
    for stream in subtitles:
        print_subtitles(stream)

def print_audio(stream):
    fields = [format_codec(stream), *format_language(stream)]
    if "bit_rate" in stream:
        bitrate = float(stream["bit_rate"])
        prefix = "~" if stream["bit_rate_fuzzy"] else ""
        fields.append("{}{:.0f} kbps".format(prefix, bitrate / 1000))
    channels = "{} channels".format(stream["channels"])
    channels = channels.replace("1 channels", "1 channel")
    fields.append(channels)
    print("Audio:", "; ".join(fields))

def print_general(path, container):
    print(os.path.basename(path))
    fields = [container["format_name"]]
    size = os.path.getsize(path)
    if size > 1024**3:
        size = size / 1024**3
        fields.append("{:.2f} GB".format(size))
    else:
        size = size / 1024**2
        fields.append("{:.0f} MB".format(size))
    duration = float(container["duration"])
    fields.append(seconds_to_time(duration))
    bitrate = float(container["bit_rate"]) / 1000
    fields.append("{:.0f} kbps".format(bitrate))
    print("; ".join(fields))

def print_subtitles(stream):
    fields = [format_codec(stream), *format_language(stream)]
    print("Subtitles:", "; ".join(fields))

def print_video(stream):
    fields = [format_codec(stream)]
    width, height = stream["width"], stream["height"]
    resolution = "{:d}x{:d}".format(width, height)
    if "display_aspect_ratio" in stream:
        ratio = stream["display_aspect_ratio"].replace(":", "/")
        ratio = float(Fraction(ratio))
        dw, dh = calculate_display_size(width, height, ratio)
        if dw != width or dh != height:
            resolution += " → {:d}x{:d}".format(dw, dh)
        resolution += " ({:.2f}:1)".format(dw/dh)
    fields.append(resolution)
    framerate = float(Fraction(stream["r_frame_rate"]))
    fields.append("{:.3f} fps".format(framerate))
    if "bit_rate" in stream:
        bitrate = float(stream["bit_rate"])
        bpp = bitrate / (width * height * framerate)
        prefix = "~" if stream["bit_rate_fuzzy"] else ""
        fields.append("{}{:.0f} kbps".format(prefix, bitrate / 1000))
        fields.append("{}{:.3f} bpp".format(prefix, bpp))
    print("Video:", "; ".join(fields))

def seconds_to_time(seconds):
    return "{:02.0f}:{:02.0f}:{:02.0f}".format(
        seconds // 3600, (seconds % 3600) // 60, seconds % 60)

if __name__ == "__main__":
    if not sys.argv[1:]:
        raise SystemExit("Usage: ffinfo FILE")
    main(sys.argv[1])
