import os
import sys

def calculate_bitrates(container, streams):
    # If ffprobe fails to detect the bitrate of just one track, we can
    # calculate that by subtracting bitrates of known tracks from the total
    # bitrate of the whole file. Considering only audio and video tracks, there
    # will be a small error since the space used by subtitles and the container
    # metadata are not accounted for.
    total = float(container["bit_rate"])
    known = 0
    for stream in streams:
        stream["bit_rate_fuzzy"] = (stream["bit_rate"] == "N/A")
        if not stream["bit_rate_fuzzy"]:
            known += float(stream["bit_rate"])
    nmissing = sum(x["bit_rate_fuzzy"] for x in streams)
    if nmissing > 1: return
    for stream in streams:
        if stream["bit_rate_fuzzy"]:
            stream["bit_rate"] = str(int(total - known))

def calculate_display_size(width, height, ratio):
    if ratio == 0:
        return width, height
    dw = int(2 * round(max(width, ratio * height) / 2))
    dh = int(2 * round(max(height, width / ratio) / 2))
    return dw, dh

def comma_print(x):
    return print0("; {}".format(x))

def main(path):
    container = read_output(("ffprobe", "-show_format", path))[0]
    streams = read_output(("ffprobe", "-show_streams", path))
    video = [x for x in streams if x.get("codec_type") == "video"]
    audio = [x for x in streams if x.get("codec_type") == "audio"]
    subtitles = [x for x in streams if x.get("codec_type") == "subtitle"]
    calculate_bitrates(container, audio + video)
    print_general(path, container)
    for stream in video:
        print_video(stream)
    for stream in audio:
        print_audio(stream)
    for stream in subtitles:
        print_subtitles(stream)

def print0(x):
    return print(x, end="")

def print_audio(stream):
    print0("Audio: ")
    format = stream["codec_tag_string"].lower()
    if format.find("[0]") > -1:
        format = stream["codec_name"]
    print0(format)
    if "TAG:language" in stream:
        if stream["TAG:language"] != "und":
            comma_print(stream["TAG:language"])
    bitrate = stream["bit_rate"]
    if bitrate != "N/A":
        bitrate = float(bitrate) / 1000
        bitrate = "{:.0f} kbps".format(bitrate)
        if stream["bit_rate_fuzzy"]:
            bitrate = "~" + bitrate
        comma_print(bitrate)
    channels = "{} channels".format(stream["channels"])
    channels = channels.replace("1 channels", "1 channel")
    comma_print(channels)
    print0("\n")

def print_general(path, container):
    print(os.path.basename(path))
    print0(container["format_name"])
    size = os.stat(path)[6]
    if size > 1024**3:
        size = size / 1024**3
        comma_print("{:.2f} GB".format(size))
    else:
        size = size / 1024**2
        comma_print("{:.0f} MB".format(size))
    duration = float(container["duration"])
    comma_print(seconds_to_time(duration))
    bitrate = float(container["bit_rate"]) / 1000
    comma_print("{:.0f} kbps".format(bitrate))
    print0("\n")

def print_subtitles(stream):
    print0("Subtitles: ")
    format = stream["codec_tag_string"].lower()
    if format.find("[0]") > -1:
        format = stream["codec_name"]
    print0(format)
    if "TAG:language" in stream:
        if stream["TAG:language"] != "und":
            comma_print(stream["TAG:language"])
    print0("\n")

def print_video(stream):
    print0("Video: ")
    format = stream["codec_tag_string"].lower()
    if format.find("[0]") > -1:
        format = stream["codec_name"]
    print0(format)
    width, height = map(int, (stream["width"], stream["height"]))
    resolution = "{:d}x{:d}".format(width, height)
    dar = stream["display_aspect_ratio"]
    if dar != "N/A":
        ratio = split_field(dar, ":", int)
        ratio = ratio[0] / ratio[1]
        dw, dh = calculate_display_size(width, height, ratio)
        if dw != width or dh != height:
            resolution += " → {:d}x{:d}".format(dw, dh)
        resolution += " ({:.2f}:1)".format(dw/dh)
    comma_print(resolution)
    framerate = split_field(stream["r_frame_rate"], "/", int)
    comma_print("{:.3f} fps".format(framerate[0]/framerate[1]))
    bitrate = stream["bit_rate"]
    if bitrate != "N/A":
        bitrate = float(bitrate) / 1000
        bitrate = "{:.0f} kbps".format(bitrate)
        if stream["bit_rate_fuzzy"]:
            bitrate = "~" + bitrate
        comma_print(bitrate)
    bitrate = stream["bit_rate"]
    if bitrate != "N/A":
        bitrate = float(bitrate)
        framerate = split_field(stream["r_frame_rate"], "/", int)
        framerate = framerate[0] / framerate[1]
        bpp = bitrate / (width * height * framerate)
        bpp = "{:.3f} bpp".format(bpp)
        if stream["bit_rate_fuzzy"]:
            bpp = "~" + bpp
        comma_print(bpp)
    print0("\n")

def read_output(command):
    from subprocess import run, PIPE, DEVNULL
    output = run(command, stdout=PIPE, stderr=DEVNULL).stdout
    output = output.decode("utf_8", errors="replace")
    sections = []
    for line in output.splitlines():
        if line.startswith("["):
            if not line.startswith("[/"):
                sections.append({})
        elif "=" in line:
            field, value = line.split("=", 1)
            sections[-1][field] = value
    return sections

def seconds_to_time(seconds):
    return "{:02.0f}:{:02.0f}:{:02.0f}".format(
        seconds // 3600, (seconds % 3600) // 60, seconds % 60)

def split_field(value, separator, fun=lambda x: x):
    return list(map(fun, value.split(separator, 2)))

if __name__ == "__main__":
    if not sys.argv[1:]:
        raise SystemExit("Usage: ffinfo FILE")
    main(sys.argv[1])
